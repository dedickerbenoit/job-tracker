{
  "manifest_version": 3,
  "name": "JobTracker BETA",
  "version": "0.1.0",
  "description": "THIS EXTENSION IS FOR BETA TESTING. Save job offers from LinkedIn, Indeed & HelloWork in one click.",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://*.indeed.com/*",
    "https://*.indeed.fr/*",
    "https://www.hellowork.com/*",
    "https://*.hellowork.com/*",
    "https://jobtracker-bd.fly.dev/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"],
      "js": [
        "debug.js",
        "content/scrapers/helpers.js",
        "content/scrapers/linkedin.js",
        "content/content.js"
      ]
    },
    {
      "matches": [
        "https://www.indeed.com/*",
        "https://*.indeed.com/*",
        "https://*.indeed.fr/*"
      ],
      "js": [
        "debug.js",
        "content/scrapers/helpers.js",
        "content/scrapers/indeed.js",
        "content/content.js"
      ]
    },
    {
      "matches": ["https://www.hellowork.com/*", "https://*.hellowork.com/*"],
      "js": [
        "debug.js",
        "content/scrapers/helpers.js",
        "content/scrapers/hellowork.js",
        "content/content.js"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
